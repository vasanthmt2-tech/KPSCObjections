      <div class="dept_text_contaoiners">
        <p class="web_name">Karnataka Public Service Commission</p>
        <!-- <p class="web_subtitle">Government of Karnataka</p> -->
			  
      </div>   
</div>
</div>                         


<div class="col-md-3 col-6 col-lg-3 flex-right rightHeadSec order3">


